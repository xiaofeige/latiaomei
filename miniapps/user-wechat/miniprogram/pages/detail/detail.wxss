/* 详情页：判决横幅（web .vcard 同款）+ 硬边内容卡 */
.d-hero { border: 6rpx solid #111; border-radius: 28rpx; padding: 26rpx 26rpx 30rpx; color: #111; box-shadow: 12rpx 12rpx 0 rgba(0, 0, 0, .16); }
.d-hero.t-hang { background: #ffc53d; }
.d-hero.t-dingji { background: #ffc3d2; }
.d-hero.t-renshang { background: #cfe6b8; }
.d-hero.t-npc { background: #a9ded5; }
.d-hero.t-la { background: #141414; color: #fff; }

.d-vh { display: flex; align-items: center; gap: 16rpx; }
.d-vh .vc { width: 56rpx; height: 56rpx; font-size: 24rpx; border-color: #111; }
.d-hero.t-la .d-vh .vc { border-color: #fff; }
.d-vk { font-size: 22rpx; font-weight: 900; letter-spacing: 2rpx; }

/* 巨型判决字：粉色硬影是 web 招牌，避雷档换红 */
.d-vw { font-size: 120rpx; font-weight: 900; line-height: 1; text-align: center; letter-spacing: -6rpx; margin: 8rpx 0 4rpx; text-shadow: 10rpx 10rpx 0 #ff5a1f; }
.d-hero.t-la .d-vw { text-shadow: 10rpx 10rpx 0 #d0452e; }
.d-vw small { display: block; font-size: 20rpx; letter-spacing: 6rpx; font-weight: 900; opacity: .72; text-shadow: none; margin-top: 10rpx; }

/* 菜品图：拍立得歪贴（web .vcard .pm） */
.d-pm { width: 74%; margin: 10rpx auto 0; background: #fffdf6; border: 6rpx solid #111; padding: 10rpx 10rpx 22rpx; transform: rotate(-2deg); box-shadow: 8rpx 8rpx 0 rgba(0, 0, 0, .25); }
.d-cover { width: 100%; height: 280rpx; display: block; }

.d-vi { text-align: center; margin-top: 20rpx; }
.d-dish { font-size: 40rpx; font-weight: 900; letter-spacing: -1rpx; }
.d-head { font-size: 26rpx; font-weight: 800; margin-top: 8rpx; opacity: .8; }
.d-chips { display: flex; justify-content: center; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.d-chip { background: #111; color: #fff; font-size: 22rpx; font-weight: 900; border-radius: 999rpx; padding: 8rpx 22rpx; }
.d-hero.t-la .d-chip { background: #ffc53d; color: #111; }

.d-meta { display: flex; gap: 26rpx; margin: 20rpx 6rpx 0; font-size: 24rpx; font-weight: 700; flex-wrap: wrap; }
.d-tastes { margin: 12rpx 0 0; }

.d-tierdesc { margin: 24rpx 6rpx 0; font-size: 24rpx; font-weight: 700; color: #7c7568; line-height: 1.7; }

.d-body { margin-top: 20rpx; font-size: 30rpx; line-height: 1.9; white-space: pre-line; color: #111; }

.d-gal { white-space: nowrap; margin-top: 24rpx; }
.d-gal-img { display: inline-block; width: 240rpx; height: 240rpx; border: 5rpx solid #111; border-radius: 16rpx; margin-right: 16rpx; background: #eee; }

/* 点单贴士：荧光黄便签，歪一点点 */
.d-tip { margin-top: 24rpx; background: #ffc53d; border: 5rpx solid #111; border-radius: 20rpx; padding: 24rpx 28rpx; font-size: 26rpx; font-weight: 800; color: #111; box-shadow: 8rpx 8rpx 0 rgba(0, 0, 0, .14); transform: rotate(-.6deg); }
.d-tip-t { font-weight: 900; margin-bottom: 8rpx; }

.d-shop { margin-top: 24rpx; display: flex; align-items: center; justify-content: space-between; padding: 28rpx 30rpx; }
.d-shop-n { font-size: 32rpx; font-weight: 900; }
.d-shop-a { color: #111; font-size: 26rpx; font-weight: 900; }
