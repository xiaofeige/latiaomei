/* 搜索药丸：小程序 input 是原生组件，padding 撑不开它的文字区，字会上下裁半。
   所以描边/硬影/背景全部画在 .sbox 容器上，显式 88rpx 高；input 只负责透明打字。 */
.sbox { display: flex; align-items: center; height: 88rpx; margin-bottom: 20rpx;
  background: #fffdf6; border: 5rpx solid #111; border-radius: 999rpx; padding: 0 24rpx;
  box-shadow: 6rpx 6rpx 0 rgba(0, 0, 0, .12); }
.s-ic { flex-shrink: 0; margin-right: 14rpx; font-size: 26rpx; line-height: 1; opacity: .65; }
.sinput { flex: 1; min-width: 0; height: 78rpx; line-height: 78rpx;
  background: transparent; font-size: 28rpx; font-weight: 700; color: #111; }
.s-ph { color: #a29a8c; font-weight: 700; }
.s-clear { flex-shrink: 0; margin-left: 12rpx; width: 40rpx; height: 40rpx; line-height: 40rpx;
  text-align: center; border-radius: 50%; background: #111; color: #fffdf6;
  font-size: 22rpx; font-weight: 900; }

.bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
/* 分段器：黑底轨道 + 荧光黄选中（对齐 web .seg） */
.seg { display: flex; background: #111; border-radius: 20rpx; padding: 6rpx; }
.seg.right { flex-wrap: wrap; justify-content: flex-end; }
.seg-i { font-size: 24rpx; font-weight: 800; color: #a29a8c; padding: 10rpx 22rpx; border-radius: 14rpx; margin-left: 4rpx; }
.seg-i.on { background: #ffc53d; color: #111; font-weight: 900; }

.chips { white-space: nowrap; margin-bottom: 8rpx; }
.chips .chip { margin-bottom: 16rpx; }
.moretip { text-align: center; padding: 24rpx 0; }

/* 自定义 tab bar 是悬浮层，页面不自动留位：底部多留 176rpx+安全区 */
.wrap { padding-bottom: calc(240rpx + env(safe-area-inset-bottom)); }
