<view class="wrap">
  <view class="card">
    <view class="row-between">
      <view class="title">近 {{series.length}} 天访问</view>
      <view class="muted">PV / UV</view>
    </view>
    <view class="bars">
      <view class="bar-col" wx:for="{{series}}" wx:key="date" bindtap="pickDay" data-date="{{item.date}}">
        <view class="b-top">
          <view class="bar-pv" style="height:{{item._pvH}}rpx"></view>
          <view class="bar-uv" style="height:{{item._uvH}}rpx"></view>
        </view>
        <view class="bar-cap {{selected === item.date ? 'on-day' : ''}}">{{item._cap}}</view>
      </view>
    </view>
    <view class="legend muted">
      <text class="lg lg-pv"></text><text>PV</text>
      <text class="lg lg-uv"></text><text>UV</text>
      <text class="grow"></text><text class="{{selected ? 'on-day' : ''}}">{{selected || '点柱子可看某一天'}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{day}}">
    <view class="title sec-title">{{day.date}} 明细</view>
    <view class="mini-grid">
      <view class="mini"><text class="m-num">{{day.pv}}</text><text class="m-cap">PV</text></view>
      <view class="mini"><text class="m-num">{{day.uv}}</text><text class="m-cap">UV</text></view>
      <view class="mini"><text class="m-num">{{day.bot}}</text><text class="m-cap">爬虫</text></view>
      <view class="mini"><text class="m-num">{{day.api}}</text><text class="m-cap">API</text></view>
    </view>
    <view class="hourly" wx:if="{{hourly.length}}">
      <view class="h-col" wx:for="{{hourly}}" wx:key="name">
        <view class="h-bar" style="height:{{item._h}}rpx"></view>
        <view class="h-cap" wx:if="{{index % 6 === 0}}">{{item.name}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="title sec-title">热门路径</view>
    <view class="rank" wx:for="{{topPaths}}" wx:key="name">
      <text class="r-name">{{item.name}}</text>
      <text class="r-val">{{item.value}}</text>
    </view>
    <view class="empty small" wx:if="{{!topPaths.length}}">暂无数据</view>
  </view>

  <view class="card">
    <view class="title sec-title">来源</view>
    <view class="rank" wx:for="{{topRefs}}" wx:key="name">
      <text class="r-name">{{item.name}}</text>
      <text class="r-val">{{item.value}}</text>
    </view>
    <view class="empty small" wx:if="{{!topRefs.length}}">暂无数据</view>
  </view>

  <view class="card">
    <view class="title sec-title">设备</view>
    <view class="rank" wx:for="{{devices}}" wx:key="name">
      <text class="r-name">{{item.name}}</text>
      <text class="r-val">{{item.value}}</text>
    </view>
    <view class="empty small" wx:if="{{!devices.length}}">暂无数据</view>
  </view>
</view>
