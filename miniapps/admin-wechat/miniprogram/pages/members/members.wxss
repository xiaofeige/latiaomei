.intro-txt { line-height: 1.7; margin-top: 12rpx; }
.mode { margin-top: 16rpx; padding: 14rpx 18rpx; background: #fdf3e7; border-radius: 10rpx; }
.mode-on { color: #8a5a1a; font-weight: 600; font-size: 26rpx; margin-right: 12rpx; }

.ava { width: 84rpx; height: 84rpx; border-radius: 50%; margin-right: 20rpx; flex-shrink: 0; background: #f0ebe0; }
.ava.ph { text-align: center; line-height: 84rpx; color: #fff; background: var(--gold); font-size: 34rpx; }
.m-name { font-size: 30rpx; font-weight: 600; }
.oid { font-size: 22rpx; word-break: break-all; }
.note { margin-top: 4rpx; color: #8a7a5e; }

.role { font-size: 20rpx; padding: 3rpx 14rpx; border-radius: 20rpx; margin-left: 12rpx; vertical-align: middle; }
.r-owner { background: #b58f4a; color: #fff; }
.r-admin { background: #e7f0e4; color: #4a7c59; }
.r-pending { background: #f0ebe0; color: #8a8478; }
.r-banned { background: #f7e3de; color: #a0503c; }

.acts { display: flex; flex-wrap: wrap; gap: 14rpx; border-top: 1rpx solid var(--line); margin-top: 18rpx; padding-top: 16rpx; }
.acts.hint { justify-content: flex-start; }
.a { font-size: 26rpx; padding: 8rpx 24rpx; border-radius: 24rpx; background: #f5f1e8; color: var(--ink); }
.a-ok { background: var(--gold); color: #fff; }
.a-bad { color: #a0503c; background: #f9ece8; }
.foot { margin-top: 20rpx; line-height: 1.6; }
