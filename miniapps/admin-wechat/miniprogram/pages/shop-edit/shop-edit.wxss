/* 店铺档案编辑页。控件尺寸走全局，这里只留特有件。 */
.req { color: var(--rust); }
.field.row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.field.row .field-label { margin-bottom: 0; }
.field.row .input.num, .field.row .picker.num { width: 280rpx; }

.pick-row { display: flex; align-items: center; }
.btn-plain.mini, .btn.mini { padding: 14rpx 26rpx; font-size: 24rpx; line-height: 1.4; border-radius: var(--radius-ctl); }

.big-thumb { width: 100%; height: 320rpx; border-radius: var(--radius-ctl); background: #f0ebe0; }
.big-thumb.add {
  display: flex; align-items: center; justify-content: center; color: var(--ink-soft); font-size: 26rpx;
  border: 2rpx dashed var(--line); background: var(--field-bg);
}
.img-cell { position: relative; }
.img-del {
  position: absolute; right: 16rpx; top: 16rpx; width: 48rpx; height: 48rpx; line-height: 46rpx;
  text-align: center; background: rgba(0, 0, 0, 0.55); color: #fff; border-radius: 50%; font-size: 26rpx;
}

.save-bar { display: flex; padding: 10rpx 0 60rpx; }
.save-bar button { margin: 0; }
