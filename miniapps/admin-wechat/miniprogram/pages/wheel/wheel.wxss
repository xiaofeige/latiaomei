.intro { margin-bottom: 4rpx; }
.tabs { display: flex; margin: 16rpx 0 0; }
.tab { padding: 10rpx 28rpx; margin-right: 12rpx; font-size: 26rpx; color: var(--ink-soft); background: #fff; border-radius: 30rpx; }
.tab.on { background: var(--ink); color: #fff; }
.sec-title { font-size: 30rpx; }
.sub { margin: 8rpx 0 4rpx; font-size: 24rpx; }
.w-row { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0; border-top: 1rpx solid var(--line); }
.w-left { flex: 1; min-width: 0; }
.w-name { font-size: 30rpx; }
.w-off { font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 6rpx; margin-left: 12rpx; background: #efe9dc; color: #8a8478; vertical-align: middle; }
.w-act { font-size: 26rpx; padding-left: 24rpx; }
.w-act.off { color: var(--gold); }
.w-act.on { color: #a0503c; }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.empty.small { padding: 40rpx 0; }
.loadmore { text-align: center; padding: 24rpx; }
.fab { position: fixed; right: 40rpx; bottom: 60rpx; width: 108rpx; height: 108rpx; line-height: 104rpx;
  text-align: center; font-size: 60rpx; color: #fff; background: var(--gold); border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(181,143,74,0.4); }
