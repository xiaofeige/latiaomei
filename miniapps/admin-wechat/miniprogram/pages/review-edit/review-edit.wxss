/* 点评编辑页。输入控件尺寸/圆角走全局 app.wxss，这里只补页面特有件。 */
.req { color: var(--rust); }
.field.row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.field.row .field-label { margin-bottom: 0; }

.tier-pick { display: flex; gap: 10rpx; }
.tier-opt {
  flex: 1; text-align: center; padding: 20rpx 0; border-radius: var(--radius-ctl);
  background: #f0ebe0; color: var(--ink-soft); font-size: 26rpx; font-weight: 700;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.tier-opt.on { color: #fff; }

.img-row { display: flex; flex-wrap: wrap; }
.img-cell { position: relative; width: 160rpx; height: 160rpx; margin: 0 16rpx 16rpx 0; }
.thumb { width: 160rpx; height: 160rpx; border-radius: var(--radius-ctl); background: #f0ebe0; }
.thumb.add {
  display: flex; align-items: center; justify-content: center; color: var(--ink-soft); font-size: 26rpx;
  border: 2rpx dashed var(--line); background: var(--field-bg);
}
.img-del {
  position: absolute; right: -12rpx; top: -12rpx; width: 44rpx; height: 44rpx; line-height: 42rpx;
  text-align: center; background: rgba(0, 0, 0, 0.55); color: #fff; border-radius: 50%; font-size: 24rpx;
}

.tags { display: flex; flex-wrap: wrap; }
.tag-on { background: var(--gold); color: #fff; }

.save-bar { display: flex; padding: 10rpx 0 60rpx; }
.save-bar button { margin: 0; }
