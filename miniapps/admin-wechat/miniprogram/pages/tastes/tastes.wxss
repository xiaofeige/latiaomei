.gap-row { margin-top: 16rpx; }
.gap-row .input { margin-right: 16rpx; }
.add-btn { margin-top: 20rpx; }
.sec-title { font-size: 30rpx; }
.seg { display: flex; border: 1rpx solid var(--line); border-radius: 10rpx; overflow: hidden; }
.seg-i { padding: 10rpx 28rpx; font-size: 26rpx; color: var(--ink-soft); }
.seg-i.on { background: var(--ink); color: #fff; }
.t-row { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0; border-top: 1rpx solid var(--line); }
.t-left { flex: 1; min-width: 0; }
.t-name { font-size: 30rpx; }
.t-act { color: #a0503c; font-size: 26rpx; padding-left: 24rpx; }
.empty.small { padding: 40rpx 0; }
