# 辣条妹服务环境变量模板。复制成 deploy/latiaomei.env 再按需改。
# systemd 用 EnvironmentFile 读它（见 deploy/systemd/latiaomei.service）。

# 监听：只开本机，外部一律走 nginx
LATIAOMEI_ADDR=127.0.0.1:18821
LATIAOMEI_BASE=/data/www/latiaomei
LATIAOMEI_DATA=/data/www/latiaomei/data
LATIAOMEI_WEB=/data/www/latiaomei/web
LATIAOMEI_DOMAIN=latiaomei.infinityfly.xin
LATIAOMEI_TZ=Asia/Shanghai

# 运行参数
LATIAOMEI_UPLOAD_MAX_MB=6
LATIAOMEI_FLUSH_SECS=30
LATIAOMEI_READ_TIMEOUT=15
LATIAOMEI_WRITE_TIMEOUT=60

# 生产必须保持 1：会话 Cookie 只走 HTTPS。
# 只有在本机用 http 调后台（比如用 playwright 做端到端测试）时才临时设 0。
LATIAOMEI_COOKIE_SECURE=1

# Go 运行期限额，跟 systemd 的 MemoryMax=1G 配合，避免 OOM
GOMEMLIMIT=900MiB
GOGC=50
GOMAXPROCS=2

# 后台账号：只在首次部署需要。建过号之后可以删掉这两行（密码不留在磁盘上更安全）。
# 以后改密码：/data/www/latiaomei/build/latiaomei passwd -u latiaomei -p '新密码'
# LATIAOMEI_ADMIN_USER=latiaomei
# LATIAOMEI_ADMIN_PASS=换成你自己的强密码

# ---- 微信小程序（管理后台）----
# 公众平台 → 开发管理 → 开发设置 里拿。
# AppID 可以公开；AppSecret 等同于后台钥匙，只放这个文件（600 权限），绝不进仓库。
# 两项都配好小程序才能登录；缺任一一项时微信登录会明确报错，网页后台不受影响。
LATIAOMEI_WX_APPID=wx38c2602fd29699b1
# LATIAOMEI_WX_SECRET=换成你的小程序 AppSecret

# 默认关闭：陌生微信登录后只读，由第一位进入的人（owner）在小程序里放行。
# 设成 1 则任何能打开小程序的微信用户都可直接增删改内容 —— 小程序发布后全球可搜到，慎用。
# LATIAOMEI_WX_OPEN_ADMINS=0

# ---- v6 生态流水线（小程序矩阵 + 公众号 + 抖音）----
# worker（tools/pipeline）与服务端通信的静态 token。留空则 /api/pipeline/* 一律 503。
# 生成建议：openssl rand -hex 32。worker 的 systemd unit 与本网站共用本文件。
# LATIAOMEI_PIPELINE_TOKEN=换成随机长串

# 用户端微信小程序（辣条妹美食点评·粉丝侧）。与后台小程序是两个不同 appid。
# LATIAOMEI_MP_APPID=wx用户端appid
# LATIAOMEI_MP_SECRET=用户端AppSecret

# 抖音小程序（tt.login 换 openid）
# LATIAOMEI_DY_APPID=tt抖音小程序appid
# LATIAOMEI_DY_SECRET=抖音小程序Secret

# ---- 鉴店 skill：高德到店数据（扫街榜/评分/人均）----
# 在 https://console.amap.com 建应用→添加「Web服务」key（免费配额够用）。
# 不配也能跑：鉴店照常出判决，只是 platforms 里高德扫街榜一条照实写「没查到」。
# 查过的店落 amap_poi 表缓存 7 天，不烧配额。
# LATIAOMEI_AMAP_KEY=换成你的高德Web服务key
# LATIAOMEI_AMAP_CITY=杭州
# 鉴店时让模型联网检索抖音/小红书/点评/美团/知乎/微博风评（默认开；
# 这些平台没有可白嫖的公开接口，联网检索是唯一可持续的拿法）。
# LATIAOMEI_LLM_SEARCH=1
# ---- 推店/规划/附近也开外部数据（v1.10）----
# 推店/规划类对话的联网风评 enrich（默认开）：模型可搜小红书/点评/美团/抖音的实时
# 风评、热菜、人气趋势把推荐说得更活；但上卡（shops/plan）仍硬锁库存清单，不放开编店。
# 关它省 token：LATIAOMEI_REC_SEARCH=0
# LATIAOMEI_REC_SEARCH=1
# 带定位的推店时，实时查高德「附近餐饮」当周边实况参考（默认开，需上面 AMAP_KEY）；
# 按 ~1km 网格落 amap_poi 缓存（3 天 TTL）省配额。关它：LATIAOMEI_AMAP_NEARBY=0
# LATIAOMEI_AMAP_NEARBY=1
# agent 词表 / 话术外置文件（本地硬拦规则、门禁审核员设定、回复消毒禁词）。
# 这些文本天然由反面用例构成，不落在源码仓库里，服务端运行期读这个文件。
# 注意 systemd 单元里有 ProtectHome=true，别指到 /root 下（服务看不见 home）；
# 改法：编辑后再 cp 一份到 data 目录，服务按 mtime 热载，不用重启。
# LATIAOMEI_WORDS_FILE=/data/www/latiaomei/data/safety-words.txt

# ---- 以下仅 worker 读取（同一份 env 文件注入），服务端用不到 ----
# 公众号（服务号）：发文 + 模板消息提醒
# LATIAOMEI_GZH_APPID=wx公众号appid
# LATIAOMEI_GZH_SECRET=公众号Secret（公众平台→基本配置；需把本机出口IP加白名单）
# 抖音开放平台"抖音登录/视频发布"应用（与小程序可以同主体不同应用）：
# 发布视频走 /video/create 需要申请"视频发布"权限，未获批时 worker 自动落 outbox/。
# LATIAOMEI_DY_OPEN_CLIENT_KEY=
# LATIAOMEI_DY_OPEN_CLIENT_SECRET=
# AI 起草命令（stdin 收 prompt，stdout 吐 JSON）。例：codex exec / pi -p
# LATIAOMEI_AI_CMD=codex exec
