# 后端流水线通道（与 deploy/latiaomei.env 里 LATIAOMEI_PIPELINE_TOKEN 一致）
PIPELINE_BASE=http://127.0.0.1:18821
PIPELINE_TOKEN=

# LLM：任意 OpenAI 兼容端点。国内建议百炼普通按量 key（token-plan key 有周配额限制）
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus

# 渲染与产物
RENDER_TMP=/data/tmp/hf
UPLOADS_DIR=/data/www/latiaomei/data/uploads
VIDEO_DAILY_CAP=2
POLL_SECS=20
# 短视频目标时长（秒）与每镜默认停留；成片≈50s，靠 9-11 个带画面的分镜支撑
VIDEO_TARGET_SECS=50
SCENE_DUR=5

# 配音/配乐（v11）：edge-tts 旁白 + vendor/bgm CC-BY 背景音乐，失败自动退无声版
TTS_ENABLED=1
TTS_VOICE=zh-CN-XiaoyiNeural
TTS_RATE=+10%
BGM_VOLUME=0.14
VO_TAIL=0.9
# Bing 视频素材接口已下线（v11 实测 404），恢复后置 1 开启分镜剪视频
BING_VIDEOS=0

# 平台凭证（不配则对应任务降级：gzh 落盘成稿 / wxpush 直接 skip）
GZH_APPID=
GZH_SECRET=
MP_APPID=
MP_SECRET=
DY_APPID=
DY_SECRET=

# 图片理解（v12）：视觉模型，用于「素材先看内容、再决定怎么用」+ 联网图先审后插。
# 留空 = 关闭理解（分镜按顺序轮转填用户图、联网图不审核直接用）。百炼按量 key 可填 qwen-vl-max
LLM_VISION_MODEL=

# happyhorse（v13 项目制）：token-plan 视频生成，给成片加"会动的主角"（原生 DashScope 异步协议）。
# 选型（2026-09-30 实盘验通）：happyhorse-1.1 三模型里 i2v 是"能挂定妆图做首帧"里最便宜的
# （t2v 更便宜但吃不了图，保不住主角形象；r2v 最贵）。留空 HH_VIDEO_MODEL = 关闭，自动退回图卡。
HH_VIDEO_MODEL=happyhorse-1.1-i2v
# 注意：这是原生网关根地址（不带 /compatible-mode/v1），与 LLM_API_BASE 不同，必须显式配
HH_API_BASE=https://token-plan.cn-beijing.maas.aliyuncs.com
# key 默认沿用 LLM_API_KEY（同一个 token-plan key）
HH_API_KEY=
# 单条成片最多交给 happyhorse 几镜（排队/烧配额，控制成本）
HH_MAX_SHOTS=4
# 单镜生成等待上限（秒）。实测 5s 片段约 4-5 分钟
HH_WAIT_SECS=900
